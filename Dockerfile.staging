FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY app ./app
COPY migrations ./migrations
COPY scripts/prepare_staging.py ./scripts/prepare_staging.py
COPY run_auth_wrapper.py ./
CMD ["sh", "-c", "python -m scripts.prepare_staging && exec gunicorn run_auth_wrapper:app --bind 0.0.0.0:${PORT:-10000} --workers 1 --timeout 180"]
